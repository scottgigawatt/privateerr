// renovate.json5: Automated dependency update policy for Privateerr.
//
{
    //
    // Renovate schema and shared safe defaults.
    //
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":enablePreCommit"
    ],

    //
    // Keep dependency work predictable for a single-maintainer repository.
    //
    "timezone": "America/New_York",
    "schedule": ["before 8am on monday"],
    "dependencyDashboard": true,
    "labels": ["dependencies"],
    "assignees": ["scottgigawatt"],
    "reviewers": ["scottgigawatt"],

    //
    // Renovate owns every supported dependency surface in this repository.
    //
    "enabledManagers": [
        "custom.regex",
        "docker-compose",
        "dockerfile",
        "git-submodules",
        "github-actions",
        "pre-commit"
    ],

    //
    // Track Alpine pins across Dockerfiles, workflows, and the example
    // environment, plus the digest-pinned Hadolint image in pre-commit.
    //
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/",
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "ALPINE_TAG[=:]\\s*(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "depNameTemplate": "alpine",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^example\\.env$/"
            ],
            "matchStrings": [
                "ALPINE_TAG=\"\\$\\{ALPINE_TAG:-(?<currentValue>[^@\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}\""
            ],
            "depNameTemplate": "alpine",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.pre-commit-config\\.ya?ml$/"
            ],
            "matchStrings": [
                "entry:\\s+ghcr\\.io/hadolint/hadolint:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "depNameTemplate": "ghcr.io/hadolint/hadolint",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ],

    //
    // Keep related update types grouped and image pins deterministic.
    //
    "packageRules": [
        {
            "matchManagers": ["docker-compose", "dockerfile", "custom.regex"],
            "pinDigests": true
        },
        {
            "groupName": "GitHub Actions",
            "matchManagers": ["github-actions"]
        },
        {
            "groupName": "pre-commit hooks",
            "matchManagers": ["pre-commit"]
        },
        {
            "groupName": "Docker images",
            "matchManagers": ["docker-compose", "dockerfile", "custom.regex"]
        },
        {
            "groupName": "Submodules",
            "matchManagers": ["git-submodules"]
        }
    ]
}
