// renovate.json5: Automated dependency update policy for Privateerr.
//
{
    //
    // Renovate schema and shared safe defaults.
    //
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":enablePreCommit"
    ],

    //
    // Keep the recommended dependency ignores while allowing Renovate to
    // manage the real Buccaneerr image definition in test/Dockerfile.
    //
    "ignorePaths": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/vendor/**",
        "**/examples/**",
        "**/__tests__/**",
        "**/tests/**",
        "**/__fixtures__/**"
    ],

    //
    // Keep dependency work predictable for a single-maintainer repository.
    //
    "timezone": "America/New_York",
    "schedule": ["before 8am"],
    "dependencyDashboard": true,

    // Merge dependency PRs after required checks pass; keep branches current.
    "automerge": true,
    "automergeType": "pr",
    "automergeStrategy": "squash",
    "platformAutomerge": true,
    "rebaseWhen": "behind-base-branch",
    "labels": ["dependencies"],
    "assignees": ["scottgigawatt"],
    "reviewers": ["scottgigawatt"],

    //
    // Generate lock files with the same compatible npm major as Buccaneerr.
    // npm 12 also rejects Renovate's bundled npm tarball fetch by default.
    //
    "constraints": {
        "npm": "^11.0.0"
    },

    //
    // Renovate owns every supported dependency surface in this repository.
    //
    "enabledManagers": [
        "custom.regex",
        "docker-compose",
        "dockerfile",
        "git-submodules",
        "npm",
        "github-actions",
        "pre-commit",
        "pip_requirements"
    ],

    //
    // Opt in to submodule updates; listing the manager alone does not enable it.
    //
    "git-submodules": {
        "enabled": true
    },

    //
    // Track image and npm pins that need explicit extraction patterns.
    //
    "customManagers": [
        // Keep the real integration suite on a reviewed Gluetun release.
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^test/runtime/test-recovery-api\\.py$/"
            ],
            "matchStrings": [
                "\"(?<depName>qmcgaw/gluetun):(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker",
            "autoReplaceStringTemplate": "\"{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\""
        },

        {
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/",
                "/^\\.github/workflows/.*\\.ya?ml$/"
            ],
            "matchStrings": [
                "ALPINE_TAG[=:]\\s*(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "depNameTemplate": "alpine",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^example\\.env$/"
            ],
            "matchStrings": [
                "ALPINE_TAG=\"\\$\\{ALPINE_TAG:-(?<currentValue>[^@\\s}]+)@(?<currentDigest>sha256:[a-f0-9]+)\\}\""
            ],
            "depNameTemplate": "alpine",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.pre-commit-config\\.ya?ml$/"
            ],
            "matchStrings": [
                "entry:\\s+ghcr\\.io/hadolint/hadolint:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
            ],
            "depNameTemplate": "ghcr.io/hadolint/hadolint",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ],

    //
    // Keep related update types grouped and image pins deterministic.
    //
    "packageRules": [
        //
        // pre-commit still invokes --ignore-prepublish, which npm 12 rejects.
        // Keep npm 11 updates enabled until upstream supports the new CLI.
        //
        {
            "description": "Keep npm compatible with pre-commit Node hook installation",
            "matchManagers": ["npm"],
            "matchPackageNames": ["npm"],
            "allowedVersions": "<12"
        },
        {
            "description": "Keep documentation dependencies exact and hash-verified",
            "matchManagers": ["pip_requirements"],
            "rangeStrategy": "pin"
        },
        {
            "matchDatasources": ["docker"],
            "pinDigests": true
        },
        {
            "groupName": "GitHub Actions",
            "matchManagers": ["github-actions"]
        },
        {
            "groupName": "pre-commit hooks",
            "matchManagers": ["pre-commit"]
        },
        {
            "groupName": "Docker images",
            "matchDatasources": ["docker"]
        },
        {
            "groupName": "Submodules",
            "matchManagers": ["git-submodules"]
        }
    ]
}
