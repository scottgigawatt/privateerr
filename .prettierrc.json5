    //
    // .prettierrc.json5: Configure explicit, on-demand formatting for file
    //                    types supported by the Prettier VS Code extension.
    //

    //
    // Match repository-wide line endings, indentation, and conservative prose.
    //
    "$schema": "https://json.schemastore.org/prettierrc",
    "endOfLine": "lf",
    "printWidth": 100,
    "proseWrap": "preserve",
    "quoteProps": "preserve",
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false,

    //
    // Preserve the repository's four-space JSON and JSON-with-comments style.
    //
    "overrides": [
        {
            "files": ["*.json", "*.jsonc", "*.json5"],
            "options": {
                "tabWidth": 4
            }
        }
    ]
}
