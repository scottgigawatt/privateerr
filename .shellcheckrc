#
# .shellcheckrc: Resolve sourced project scripts consistently in editors and CLI checks.
#

#
# Follow local source files even when checking only one script.
#
external-sources=true

#
# Resolve source annotations relative to the script being checked.
#
source-path=SCRIPTDIR
