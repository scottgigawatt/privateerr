// pyrightconfig.json: Shared strict Python checks for editors, tests, and CI.
//

{
    "include": [
        "docker/privateerr",
        "test"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.*"
    ],
    "typeCheckingMode": "strict",
    "reportUnnecessaryTypeIgnoreComment": "error",
    "pythonVersion": "3.14",
    "pythonPlatform": "Linux",
    "extraPaths": [
        "docker",
        "test/runtime"
    ]
}
