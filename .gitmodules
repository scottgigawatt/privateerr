#
# .gitmodules: Register the official PIA manual connection scripts used by
#              Privateerr without modifying their upstream source.
#

#
# Keep the PIA scripts as a distinct third-party submodule. Clone recursively
# so the Privateerr image build context contains the pinned upstream revision.
# Use HTTPS so this public, read-only dependency needs no GitHub SSH key.
#
[submodule "docker/pia-manual-connections"]
	path = docker/pia-manual-connections
	url = https://github.com/pia-foss/manual-connections.git
