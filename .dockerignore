#
# .dockerignore: Allow only Buccaneerr sources and the locked documentation toolchain.
#

#
# Exclude credentials, generated VPN state, Git metadata, and unrelated sources by default.
#
**
!requirements-docs.txt
!test/
!test/**

#
# Test logs, bytecode, and workstation metadata remain local.
#
test/logs/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/*.log
